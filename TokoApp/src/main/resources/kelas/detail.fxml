<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.DetailController" stylesheets="@styles/app.css">
    <top>
        <HBox spacing="16" styleClass="header">
            <Label text="Detail Produk" styleClass="title"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox spacing="16" styleClass="page">
                    <VBox spacing="10" styleClass="card">
                        <Label text="Kode Produk" styleClass="muted"/>
                        <Label fx:id="kodeLabel" styleClass="subtitle"/>
                        
                        <Label text="Nama Produk" styleClass="muted"/>
                        <Label fx:id="namaLabel" wrapText="true" styleClass="bold"/>
                        
                        <Label text="Kategori Produk" styleClass="muted"/>
                        <Label fx:id="kategoriLabel"/>
                        
                        <Label text="Harga Produk (Rp)" styleClass="muted"/>
                        <Label fx:id="hargaLabel" styleClass="title"/>
                        
                        <Label text="Foto Produk" styleClass="muted"/>
                        <ImageView fx:id="fotoBesar" fitWidth="180" fitHeight="180" preserveRatio="true"/>
                        
                        <Label fx:id="pesanLabel" wrapText="true" styleClass="error"/>
                        
                        <Button text="Kembali ke Daftar" onAction="#bukaDaftar" styleClass="button-primary" maxWidth="Infinity"/>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>